# =====================================================
# AI-Style Mock Interview Simulator — .gitignore
# =====================================================

# OS Files
.DS_Store
Thumbs.db
desktop.ini
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# IDE and Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Node.js (not used, but future-safe)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build Outputs (not applicable, but future-safe)
dist/
build/
out/

# Credentials — NEVER COMMIT
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
credentials.json

# Logs
*.log
logs/

# Temporary / Scratch Files
*.tmp
*.bak
*.orig
temp/
scratch/

